# API listen port (4001 when Vite UI uses 4000 in dev).
PORT=4000
NODE_ENV=development
PYTHON_SERVICE_URL=http://127.0.0.1:8000
# Axios timeout (ms) for uploads proxied to FastAPI — default 600000 (10 min) if unset.
# PYTHON_SERVICE_TIMEOUT_MS=600000
# JWT access token (short-lived)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m
# Refresh token cookie lifetime
REFRESH_TOKEN_EXPIRES_IN=7d
# CORS_ORIGIN=http://localhost:4000,https://app.example.com
CORS_ORIGIN=*
REQUEST_BODY_JSON_LIMIT=50mb
UPLOAD_MAX_BYTES=52428800
# Set false to disable Swagger UI (/api-docs) in production.
ENABLE_SWAGGER=true
