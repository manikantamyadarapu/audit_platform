# API listen port — must match frontend/.env VITE_BACKEND_PORT (4002 in this repo's dev setup).
PORT=4002
NODE_ENV=development
PYTHON_SERVICE_URL=http://127.0.0.1:8000
# Axios timeout (ms) for uploads proxied to FastAPI — default 600000 (10 min) if unset.
# PYTHON_SERVICE_TIMEOUT_MS=600000
# Development: omit or use * for allow-all. Production: comma-separated origins (required).
# CORS_ORIGIN=http://localhost:4000,https://app.example.com
CORS_ORIGIN=*
REQUEST_BODY_JSON_LIMIT=50mb
UPLOAD_MAX_BYTES=52428800
# Set false to disable Swagger UI (/api-docs) in production.
ENABLE_SWAGGER=true
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h
JWT_REMEMBER_EXPIRES_IN=30d
FRONTEND_URL=http://localhost:4000
# Optional SMTP — if unset, reset links are logged in dev only.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=noreply@haa-audit.com
