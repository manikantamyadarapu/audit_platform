  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "DashboardErrorBody": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "message": { "type": "string", "example": "Invalid period filter" }
        }
      },
      "DashboardWidgetMetric": {
        "type": "object",
        "properties": {
          "value": { "type": "number", "example": 124 },
          "change": { "type": "number", "example": 18 },
          "trend": { "type": "string", "enum": ["up", "down", "neutral"], "example": "up" }
        }
      },
      "DashboardWidgetsData": {
        "type": "object",
        "properties": {
          "period": { "type": "string", "enum": ["week", "month", "year"], "example": "week" },
          "totalAudits": { "$ref": "#/components/schemas/DashboardWidgetMetric" },
          "totalRecords": { "$ref": "#/components/schemas/DashboardWidgetMetric" },
          "totalIssues": { "$ref": "#/components/schemas/DashboardWidgetMetric" },
          "accuracy": { "$ref": "#/components/schemas/DashboardWidgetMetric" }
        }
      },
      "DashboardWidgetsSuccess": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string", "example": "Dashboard widgets fetched successfully" },
          "data": { "$ref": "#/components/schemas/DashboardWidgetsData" }
        }
      },
      "DashboardAuditTrendData": {
        "type": "object",
        "properties": {
          "period": { "type": "string", "enum": ["daily", "weekly", "monthly"], "example": "daily" },
          "labels": { "type": "array", "items": { "type": "string" } },
          "auditsProcessed": { "type": "array", "items": { "type": "integer" } },
          "issuesFound": { "type": "array", "items": { "type": "integer" } }
        }
      },
      "DashboardAuditTrendSuccess": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string", "example": "Audit trend fetched successfully" },
          "data": { "$ref": "#/components/schemas/DashboardAuditTrendData" }
        }
      },
      "DashboardIssueCategoryItem": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "example": "PAN Issues" },
          "count": { "type": "integer", "example": 856 },
          "percentage": { "type": "number", "example": 39.7 }
        }
      },
      "DashboardIssuesCategoryData": {
        "type": "object",
        "properties": {
          "period": { "type": "string", "enum": ["week", "month", "year"], "example": "week" },
          "totalIssues": { "type": "integer", "example": 2156 },
          "categories": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/DashboardIssueCategoryItem" }
          }
        }
      },
      "DashboardIssuesCategorySuccess": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string", "example": "Issues by category fetched successfully" },
          "data": { "$ref": "#/components/schemas/DashboardIssuesCategoryData" }
        }
      },
      "ErrorBody": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "detail": { "type": "string" },
          "requestId": { "type": "string" }
        }
      },
      "PanInvalidRecord": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
