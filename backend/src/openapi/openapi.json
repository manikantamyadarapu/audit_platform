{
  "openapi": "3.0.3",
  "info": {
    "title": "HAA-Audit-Platfrom",
    "description": "Proxies PAN Excel validation and invalid-row export to the FastAPI `python-service`. Use **Try it out** to upload a file or POST JSON.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "Same origin as this Express server"
    }
  ],
  "tags": [
    { "name": "Auth" },
    { "name": "Users" },
    { "name": "Health" },
    { "name": "PAN" },
    { "name": "Gross weight" },
    { "name": "Sales" },
    { "name": "Rate rules" },
    { "name": "Diamond rate rules" },
    { "name": "Sales return" },
    { "name": "Dashboard" }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "ok" },
                    "service": { "type": "string", "example": "audit-platform-node-backend" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/dashboard/widgets": {
      "get": {
        "tags": ["Dashboard"],
        "summary": "Get dashboard KPI widgets with period trends",
        "description": "Returns total audits, records, issues, and accuracy with trend vs the previous period. Requires JWT Bearer token.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "query",
            "name": "period",
            "schema": { "type": "string", "enum": ["week", "month", "year"], "default": "week" },
            "description": "week = last 7 days, month = last 30 days, year = last 365 days"
          }
        ],
        "responses": {
          "200": {
            "description": "Dashboard widgets fetched successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DashboardWidgetsSuccess" },
                "example": {
                  "success": true,
                  "message": "Dashboard widgets fetched successfully",
                  "data": {
                    "period": "week",
                    "totalAudits": { "value": 124, "change": 18, "trend": "up" },
                    "totalRecords": { "value": 48562, "change": 24, "trend": "up" },
                    "totalIssues": { "value": 2156, "change": -8, "trend": "down" },
                    "accuracy": { "value": 94.62, "change": 6, "trend": "up" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid period filter",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DashboardErrorBody" },
                "example": { "success": false, "message": "Invalid period filter" }
              }
            }
          },
          "401": {
            "description": "Access token required",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DashboardErrorBody" },
                "example": { "success": false, "message": "Access token required" }
              }
            }
          },
          "403": {
            "description": "Invalid or expired token",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DashboardErrorBody" },
                "example": { "success": false, "message": "Invalid or expired token" }
              }
            }
          },
          "404": {
            "description": "Dashboard data not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DashboardErrorBody" },
                "example": { "success": false, "message": "Dashboard data not found" }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DashboardErrorBody" },
                "example": { "success": false, "message": "Internal server error" }
              }
            }
          }
        }
      }
    },
    "/api/v1/dashboard/widgets": {
      "get": {
        "tags": ["Dashboard"],
        "summary": "Get dashboard KPI widgets with period trends (v1)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "query",
            "name": "period",
            "schema": { "type": "string", "enum": ["week", "month", "year"], "default": "week" }
          }
        ],
        "responses": {
          "200": {
            "description": "Dashboard widgets fetched successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DashboardWidgetsSuccess" }
              }
            }
          },
          "400": { "description": "Invalid period filter" },
          "401": { "description": "Access token required" },
          "403": { "description": "Invalid or expired token" },
          "404": { "description": "Dashboard data not found" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/api/dashboard/audit-trend": {
      "get": {
        "tags": ["Dashboard"],
        "summary": "Get audit activity trend chart data",
        "description": "Returns chart-ready time series for Audits Processed and Issues Found. Requires JWT Bearer token.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "query",
            "name": "period",
            "schema": { "type": "string", "enum": ["daily", "weekly", "monthly"], "default": "daily" },
            "description": "daily = last 7 days, weekly = last 12 weeks, monthly = last 12 months"
          }
        ],
        "responses": {
          "200": {
            "description": "Audit trend fetched successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DashboardAuditTrendSuccess" },
                "example": {
                  "success": true,
                  "message": "Audit trend fetched successfully",
                  "data": {
                    "period": "daily",
                    "labels": ["Dec 10", "Dec 11", "Dec 12", "Dec 13", "Dec 14", "Dec 15", "Dec 16"],
                    "auditsProcessed": [220, 760, 680, 1080, 1080, 1180, 1920],
                    "issuesFound": [50, 410, 220, 520, 350, 410, 860]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid period filter",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DashboardErrorBody" },
                "example": { "success": false, "message": "Invalid period filter" }
              }
            }
          },
          "401": {
            "description": "Access token required",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DashboardErrorBody" },
                "example": { "success": false, "message": "Access token required" }
              }
            }
          },
          "403": {
            "description": "Invalid or expired token",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DashboardErrorBody" },
                "example": { "success": false, "message": "Invalid or expired token" }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DashboardErrorBody" },
                "example": { "success": false, "message": "Internal server error" }
              }
            }
          }
        }
      }
    },
    "/api/v1/dashboard/audit-trend": {
      "get": {
        "tags": ["Dashboard"],
        "summary": "Get audit activity trend chart data (v1)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "query",
            "name": "period",
            "schema": { "type": "string", "enum": ["daily", "weekly", "monthly"], "default": "daily" }
          }
        ],
        "responses": {
          "200": {
            "description": "Audit trend fetched successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DashboardAuditTrendSuccess" }
              }
            }
          },
          "400": { "description": "Invalid period filter" },
          "401": { "description": "Access token required" },
          "403": { "description": "Invalid or expired token" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/api/dashboard/issues-category": {
      "get": {
        "tags": ["Dashboard"],
        "summary": "Get issues grouped by dashboard category",
        "description": "Returns issue counts and percentages grouped into PAN, Gross Weight, Rate Verification, ID Proof, and Other categories. Requires JWT Bearer token.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "query",
            "name": "period",
            "schema": { "type": "string", "enum": ["week", "month", "year"], "default": "week" },
            "description": "week = last 7 days, month = last 30 days, year = last 365 days"
          }
        ],
        "responses": {
          "200": {
            "description": "Issues by category fetched successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DashboardIssuesCategorySuccess" },
                "example": {
                  "success": true,
                  "message": "Issues by category fetched successfully",
                  "data": {
                    "totalIssues": 2156,
                    "categories": [
                      { "name": "PAN Issues", "count": 856, "percentage": 39.7 },
                      { "name": "Gross Weight Issues", "count": 542, "percentage": 25.1 },
                      { "name": "Rate Verification Issues", "count": 420, "percentage": 19.5 },
                      { "name": "ID Proof Issues", "count": 214, "percentage": 9.9 },
                      { "name": "Other Issues", "count": 124, "percentage": 5.8 }
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid period filter",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DashboardErrorBody" },
                "example": { "success": false, "message": "Invalid period filter" }
              }
            }
          },
          "401": {
            "description": "Access token required",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DashboardErrorBody" },
                "example": { "success": false, "message": "Access token required" }
              }
            }
          },
          "403": {
            "description": "Invalid or expired token",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DashboardErrorBody" },
                "example": { "success": false, "message": "Invalid or expired token" }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DashboardErrorBody" },
                "example": { "success": false, "message": "Internal server error" }
              }
            }
          }
        }
      }
    },
    "/api/v1/dashboard/issues-category": {
      "get": {
        "tags": ["Dashboard"],
        "summary": "Get issues grouped by dashboard category (v1)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "in": "query",
            "name": "period",
            "schema": { "type": "string", "enum": ["week", "month", "year"], "default": "week" }
          }
        ],
        "responses": {
          "200": {
            "description": "Issues by category fetched successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DashboardIssuesCategorySuccess" }
              }
            }
          },
          "400": { "description": "Invalid period filter" },
          "401": { "description": "Access token required" },
          "403": { "description": "Invalid or expired token" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/api/v1/users": {
      "get": {
        "tags": ["Users"],
        "summary": "Get all users",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "in": "query", "name": "search", "schema": { "type": "string" } },
          { "in": "query", "name": "page", "schema": { "type": "integer", "default": 1 } },
          { "in": "query", "name": "limit", "schema": { "type": "integer", "default": 10 } }
        ],
        "responses": {
          "200": { "description": "List of users" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      },
      "post": {
        "tags": ["Users"],
        "summary": "Create user",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "example": "John Doe" },
                  "email": { "type": "string", "example": "john@audit.com" },
                  "password": { "type": "string", "example": "password123" },
                  "role": { "type": "string", "enum": ["ADMIN", "AUDITOR", "VIEWER"], "example": "AUDITOR" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "User created" },
          "400": { "description": "Validation error" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "409": { "description": "Email exists" }
        }
      }
    },
    "/api/v1/users/{id}": {
      "get": {
        "tags": ["Users"],
        "summary": "Get user by ID",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "in": "path", "name": "id", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "User details" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "User not found" }
        }
      },
      "put": {
        "tags": ["Users"],
        "summary": "Update user",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "in": "path", "name": "id", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "email": { "type": "string" },
                  "role": { "type": "string", "enum": ["ADMIN", "AUDITOR", "VIEWER"] },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "User updated" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "User not found" },
          "409": { "description": "Email exists" }
        }
      },
      "delete": {
        "tags": ["Users"],
        "summary": "Delete user",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "in": "path", "name": "id", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "User deleted" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "User not found" }
        }
      }
    },
    "/api/v1/users/{id}/password": {
      "put": {
        "tags": ["Users"],
        "summary": "Change password",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "in": "path", "name": "id", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "newPassword": { "type": "string", "example": "newpassword123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Password changed" },
          "400": { "description": "Validation error" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "404": { "description": "User not found" }
        }
      }
    },
    "/api/v1/process/pan/validate": {
      "post": {
        "operationId": "panValidateExcel",
        "tags": ["PAN"],
        "summary": "Validate PAN Excel (multipart upload)",
        "description": "Upload an Excel file. Field name must be **`file`**. Response body matches Python `POST /api/process/pan` (JSON preview with invalid rows in `records`).",
        "parameters": [
          {
            "name": "x-request-id",
            "in": "header",
            "required": false,
            "schema": { "type": "string", "format": "uuid" },
            "description": "Optional correlation id (also returned in error JSON)."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file"],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Excel workbook (.xlsx, .xlsm, .xls)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validation result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Bad request (missing file, invalid type, Python 400)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" }
              }
            }
          },
          "422": {
            "description": "Validation error (Python missing columns / schema)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" }
              }
            }
          },
          "502": {
            "description": "Python service unreachable or error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" }
              }
            }
          }
        }
      }
    },
    "/api/v1/process/pan/export-invalid": {
      "post": {
        "operationId": "panExportInvalid",
        "tags": ["PAN"],
        "summary": "Export invalid rows as Excel",
        "description": "Send **`records`** exactly as returned by **Validate** (`records` = list of rows with issues). Request body must be `{ \"records\": [ ... ] }` (minimum one row). Response is binary `.xlsx` (save from browser or use curl `--output`). Proxies to Python `POST /api/process/pan/export-invalid`.",
        "parameters": [
          {
            "name": "x-request-id",
            "in": "header",
            "required": false,
            "schema": { "type": "string", "format": "uuid" },
            "description": "Optional correlation id (also returned in error JSON)."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["records"],
                "properties": {
                  "records": {
                    "type": "array",
                    "minItems": 1,
                    "description": "Invalid rows only — copy from validate response `records`.",
                    "items": { "$ref": "#/components/schemas/PanInvalidRecord" }
                  }
                }
              },
              "examples": {
                "fromValidateResponse": {
                  "summary": "Typical — paste your validate `records` here",
                  "description": "After validate, wrap the array: `{ \"records\": <paste records array> }`",
                  "value": {
                    "records": [
                      {
                        "rowNumber": 77,
                        "date": "03-04-2025",
                        "voucherNo": "JH/B/2526/1",
                        "party": "Kundan Crafts Private Limited",
                        "totalValue": 18790000,
                        "pan": "AAECK7089G",
                        "pan1": "",
                        "addProof": "",
                        "addProof2": "",
                        "issues": ["MISSING_ADDRESS_PROOF_ABOVE_50K"]
                      }
                    ]
                  }
                },
                "minimal": {
                  "summary": "Minimal shape",
                  "value": {
                    "records": [{ "rowNumber": 5, "issues": ["MISSING_PAN_ABOVE_2L"] }]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Excel workbook download (`invalid` rows sheet)",
            "headers": {
              "Content-Type": {
                "schema": { "type": "string", "example": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" }
              },
              "Content-Disposition": {
                "schema": {
                  "type": "string",
                  "example": "attachment; filename=\"pan-invalid-rows-20260101120000.xlsx\""
                }
              }
            },
            "content": {
              "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": {
                "schema": { "type": "string", "format": "binary" }
              },
              "application/octet-stream": {
                "schema": { "type": "string", "format": "binary" }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" }
              }
            }
          },
          "502": {
            "description": "Python service error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" }
              }
            }
          }
        }
      }
    },
