{
  "openapi": "3.0.3",
  "info": {
    "title": "Audit Platform — Node API (PAN)",
    "description": "Proxies PAN Excel validation and invalid-row export to the FastAPI `python-service`. Use **Try it out** to upload a file or POST JSON.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "Same origin as this Express server"
    }
  ],
  "tags": [
    { "name": "Health", "description": "Service health" },
    {
      "name": "PAN",
      "description": "PAN Excel validation via Python. **Flow:** (1) `validate` → copy JSON field `records`. (2) `export-invalid` → POST `{ \"records\": [ ... ] }` with that array → download `.xlsx`."
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "ok" },
                    "service": { "type": "string", "example": "audit-platform-node-backend" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/process/pan/validate": {
      "post": {
        "operationId": "panValidateExcel",
        "tags": ["PAN"],
        "summary": "Validate PAN Excel (multipart upload)",
        "description": "Upload an Excel file. Field name must be **`file`**. Response body matches Python `POST /api/process/pan` (JSON preview with invalid rows in `records`).",
        "parameters": [
          {
            "name": "x-request-id",
            "in": "header",
            "required": false,
            "schema": { "type": "string", "format": "uuid" },
            "description": "Optional correlation id (also returned in error JSON)."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file"],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Excel workbook (.xlsx, .xlsm, .xls)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validation result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Bad request (missing file, invalid type, Python 400)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" }
              }
            }
          },
          "422": {
            "description": "Validation error (Python missing columns / schema)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" }
              }
            }
          },
          "502": {
            "description": "Python service unreachable or error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" }
              }
            }
          }
        }
      }
    },
    "/api/v1/process/pan/export-invalid": {
      "post": {
        "operationId": "panExportInvalid",
        "tags": ["PAN"],
        "summary": "Export invalid rows as Excel",
        "description": "Send **`records`** exactly as returned by **Validate** (`records` = list of rows with issues). Request body must be `{ \"records\": [ ... ] }` (minimum one row). Response is binary `.xlsx` (save from browser or use curl `--output`). Proxies to Python `POST /api/process/pan/export-invalid`.",
        "parameters": [
          {
            "name": "x-request-id",
            "in": "header",
            "required": false,
            "schema": { "type": "string", "format": "uuid" },
            "description": "Optional correlation id (also returned in error JSON)."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["records"],
                "properties": {
                  "records": {
                    "type": "array",
                    "minItems": 1,
                    "description": "Invalid rows only — copy from validate response `records`.",
                    "items": { "$ref": "#/components/schemas/PanInvalidRecord" }
                  }
                }
              },
              "examples": {
                "fromValidateResponse": {
                  "summary": "Typical — paste your validate `records` here",
                  "description": "After validate, wrap the array: `{ \"records\": <paste records array> }`",
                  "value": {
                    "records": [
                      {
                        "rowNumber": 77,
                        "date": "03-04-2025",
                        "voucherNo": "JH/B/2526/1",
                        "party": "Kundan Crafts Private Limited",
                        "totalValue": 18790000,
                        "pan": "AAECK7089G",
                        "pan1": "",
                        "addProof": "",
                        "addProof2": "",
                        "issues": ["MISSING_ADDRESS_PROOF_ABOVE_50K"]
                      }
                    ]
                  }
                },
                "minimal": {
                  "summary": "Minimal shape",
                  "value": {
                    "records": [{ "rowNumber": 5, "issues": ["MISSING_PAN_ABOVE_2L"] }]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Excel workbook download (`invalid` rows sheet)",
            "headers": {
              "Content-Type": {
                "schema": { "type": "string", "example": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" }
              },
              "Content-Disposition": {
                "schema": {
                  "type": "string",
                  "example": "attachment; filename=\"pan-invalid-rows-20260101120000.xlsx\""
                }
              }
            },
            "content": {
              "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": {
                "schema": { "type": "string", "format": "binary" }
              },
              "application/octet-stream": {
                "schema": { "type": "string", "format": "binary" }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" }
              }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" }
              }
            }
          },
          "502": {
            "description": "Python service error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PanInvalidRecord": {
        "type": "object",
        "description": "One invalid row from PAN validate JSON (field names as returned by API).",
        "properties": {
          "rowNumber": { "type": "integer", "example": 77 },
          "date": { "type": "string", "example": "03-04-2025" },
          "voucherNo": { "type": "string" },
          "party": { "type": "string" },
          "totalValue": { "type": "number" },
          "pan": { "type": "string" },
          "pan1": { "type": "string" },
          "addProof": { "type": "string" },
          "addProof2": { "type": "string" },
          "issues": {
            "type": "array",
            "items": { "type": "string" },
            "example": ["MISSING_PAN_ABOVE_2L", "MISSING_ADDRESS_PROOF_ABOVE_50K"]
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "detail": { "type": "string" },
          "requestId": { "type": "string" }
        }
      }
    }
  }
}
