    "/api/v1/process/gross-weight/export-invalid": {
      "post": {
        "operationId": "grossWeightExportInvalid",
        "tags": ["Gross weight"],
        "summary": "Export invalid gross-weight rows as Excel",
        "description": "Send **`records`** exactly as returned by **Validate**. Request body must be `{ \"records\": [ ... ] }`. Response is binary `.xlsx`.",
        "parameters": [
          {
            "name": "x-request-id",
            "in": "header",
            "required": false,
            "schema": { "type": "string", "format": "uuid" },
            "description": "Optional correlation id."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["records"],
                "properties": {
                  "records": { "type": "array", "minItems": 1, "items": { "type": "object" } }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Excel workbook download (`invalid` rows sheet)",
            "content": {
              "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": {
                "schema": { "type": "string", "format": "binary" }
              }
            }
