    },
    "/api/v1/process/sales/validate": {
      "post": {
        "operationId": "salesValidateExcel",
        "tags": ["Sales"],
        "summary": "Validate sales ledger Excel (multipart upload)",
        "description": "Upload an Excel file. Field name must be **`file`**. Proxies to Python `POST /api/process/sales`.",
        "parameters": [
          {
            "name": "x-request-id",
            "in": "header",
            "required": false,
            "schema": { "type": "string", "format": "uuid" },
            "description": "Optional correlation id."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file"],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Excel workbook (.xlsx, .xlsm, .xls)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Processing result JSON",
            "content": {
              "application/json": {
                "schema": { "type": "object", "additionalProperties": true }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" }
              }
            }
          },
          "422": {
            "description": "Validation error (e.g. missing columns)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" }
              }
            }
          },
          "502": {
            "description": "Python service unreachable or error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorBody" }
              }
            }
          }
        }
      }
    },
    "/api/v1/process/sales/export-invalid": {
      "post": {
        "operationId": "salesExportInvalid",
        "tags": ["Sales"],
        "summary": "Export invalid sales rows as Excel",
        "description": "Send **`records`** exactly as returned by **Validate**. Request body must be `{ \"records\": [ ... ] }`. Response is binary `.xlsx`.",
        "parameters": [
          {
            "name": "x-request-id",
            "in": "header",
            "required": false,
            "schema": { "type": "string", "format": "uuid" },
