APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO
CHUNK_SIZE=2500
GROSS_WEIGHT_TOLERANCE=0.5
# Gross-weight audit only: manual vs auto must agree within this amount (default 0.001).
GROSS_WEIGHT_MATCH_EPSILON=0.002
# Debug workbooks (slow on large files). Leave false for normal API speed.
AUDIT_DEBUG_EXPORT=false
SALES_DEBUG_EXPORT=false
