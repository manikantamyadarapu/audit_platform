  "account_product_rules": {
    "GOLD SALES ACCOUNT - 14K": {
      "patterns": ["^GOLD ORNAMENTS 14K$"]
    },
    "GOLD SALES ACCOUNT - 18K": {
      "patterns": ["^GOLD ORNAMENTS 18K$", "^CUSTOMER GOLD ORNAMENTS 18K$"]
    },
    "GOLD SALES ACCOUNT - 22K": {
      "patterns": [
        "^BLACK BEADS$",
        "^CUSTOMER GOLD ORNAMENTS 22K$",
        "^DORI$",
        "^GOLD ORNAMENTS 22K$",
        "^LAC$",
        "^WAX, DORI ETC$"
      ],
      "exact": ["KUNDAN", "NAIL"]
    },
    "GOLD SALES ACCOUNT - JADAU": {
      "patterns": ["^GOLD ORNAMENTS JADAU$"]
    },
    "GOLD SALES ACCOUNT - 24K": {
      "patterns": ["^STANDARD GOLD 24K$"]
    },
    "SILVER SALES ACCOUNT": {
      "patterns": ["^SILVER ARTICLES$"]
    },
    "JEWEL SALES ACCOUNT - DIAMONDS": {
      "patterns": [
        "^CHAKRI$",
        "^CUSTOMER DIAMONDS$",
        "^CUSTOMER FLAT POLKI$",
        "^DI\\. RA \\d+$",
        "^DI\\. RC \\d+$",
        "^DIAMONDS LOOSE DI\\. RA \\d+$",
        "^DIAMONDS LOOSE DI\\. SD \\d+$",
        "^DIAMONDS LOOSE SD DI\\. MIX$",
        "^FLAT POLKI FP \\d+$",
        "^POLKI A$",
        "^SD DI\\. \\d+$",
        "^SD DI\\. MIX$"
      ],
      "exact": [
        "DI. BEADS",
        "DI. BEADS 1",
        "DI. BEADS 2",
        "DI. BEADS 3",
        "DI. RC 3",
        "DI. RC 4",
        "DI. RC 18",
        "DI. RC 20"
      ]
    },
    "JEWELS SALES ACCOUNT - COLOR STONES": {
      "patterns": [
        "^CUSTOMER STONES$",
        "^PRECIOUS STONES JOS \\d+$",
        "^PRECIOUS STONES LOOSE JOS \\d+$",
        "^SEMI PRECIOUS JSP \\d+$",
        "^SYNTHETIC JSY \\d+$"
      ],
      "exact": ["SYNTHETIC SYN 100", "SYNTHETIC SYN 300", "SYTHETIC JSY 300"]
    },
    "JEWELS SALES ACCOUNT - EMERALDS": {
      "patterns": [
        "^CUSTOMER EMERALDS$",
        "^EMERALDS JEM \\d+$",
        "^EMERALDS JEM LOOSE \\d+$",
        "^EMERALDS JEM MIX$"
      ],
      "exact": ["EMERALDS JEM 5900"]
    },
    "JEWELS SALES ACCOUNT - PEARLS": {
      "patterns": ["^CUSTOMER PEARLS$", "^PEARLS JPS \\d+$"]
    },
    "JEWELS SALES ACCOUNT - RUBIES": {
      "patterns": [
        "^CUSTOMER RUBIES$",
        "^RUBIES JRU \\d+$",
        "^RUBIES JRU LOOSE \\d+$",
        "^RUBIES JRU MIX$"
      ],
      "exact": ["RUBIES JRU 7700"]
    }
  }
