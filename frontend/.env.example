# Dev: Vite UI port and Node API port (must match backend/.env PORT exactly).
VITE_DEV_PORT=4000
VITE_BACKEND_PORT=4002
# For production builds, set the full Node gateway URL, e.g. https://api.company.com
VITE_API_BASE_URL=
# Optional legacy direct Python URL (not required — rate book uses Node /api/v1/rate-book/*)
VITE_API_URL=
